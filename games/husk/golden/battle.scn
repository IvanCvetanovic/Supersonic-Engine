# The auto-battle harness's standard 20v20 (sim/harness.rs, seed 11 as
# tests/determinism.rs uses it): mirrored stalker/golem/wisp squads a-move
# into each other on open ground. Acquisition, taunt, chain-arc, damage order.
# Run past the wipe on purpose: the survivors' idle and leash logic is covered.
seed 11
ticks 2400
squad team=0 x=-12.0 y=32.0 comp=stalker:10,golem:6,wisp:4
squad team=1 x=12.0 y=32.0 comp=stalker:10,golem:6,wisp:4
0 point units=0-19 attack=1 x=12.0 y=32.0 queued=0
0 point units=20-39 attack=1 x=-12.0 y=32.0 queued=0
