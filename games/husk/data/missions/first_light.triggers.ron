(
objectives: [
    (name: "descend", text: "Get off the mountain - head down the slope (south)", optional: false),
],
triggers: [
    (name: "wake",
     when: [TimeAtLeast(1.5)],
     actions: [Message("Your head is full of light. Your father, your brother - gone. Not dead, just... not here. The mountain is burning. Move. Get down.")]),
    // descend into the valley and find the dead -> the trance, the voice, the flight
    (name: "the dead",
     when: [ObjectiveActive("descend"), HeroInArea(x: 0.0, y: 2.0, radius: 12.0)],
     actions: [CompleteObjective("descend"),
               Message("Bodies. Hikers, like you were an hour ago. You stop, and the world goes white at the edges -"),
               Say(speaker: "voice", text: "RUN. As fast as you can. Do not look at them. RUN."),
               AddObjective(name: "flee", text: "Run - get clear of the dead", optional: false),
               SpawnSquad(unit: "golem", count: 2, x: 0.0, y: 16.0, aggressive: true)]),
    // reach the lower valley -> the voice teaches him to fight back with flora
    (name: "fight back",
     when: [ObjectiveActive("flee"), HeroInArea(x: 0.0, y: -32.0, radius: 14.0)],
     actions: [CompleteObjective("flee"),
               Say(speaker: "voice", text: "You cannot outrun them. But the green - the flora - it answers you now. Take it. Drain it. Make more of yourself."),
               AddObjective(name: "gather", text: "Drain the trees - gather 400 essence (right-click a tree with the hero)", optional: false)]),
    (name: "gathered",
     when: [ObjectiveActive("gather"), EssenceAtLeast(400.0)],
     actions: [CompleteObjective("gather"),
               GrantHeroXp(100.0),
               AddObjective(name: "found", text: "Raise a Sanctum - a heart for the green ([B], then channel flat ground)", optional: false),
               Say(speaker: "voice", text: "Now give it shape. A heart, set in the ground. Build.")]),
    (name: "founded",
     when: [ObjectiveActive("found"), PlayerBuildingsOfAtLeast(building: "sanctum", count: 1)],
     actions: [CompleteObjective("found"),
               GrantHeroXp(100.0),
               AddObjective(name: "crew", text: "Forge 2 Siphons to carry the gathering (Sanctum, [Q])", optional: false),
               Say(speaker: "voice", text: "It beats with you now. Make hands to gather - Siphons - so yours are free to fight.")]),
    (name: "crewed",
     when: [ObjectiveActive("crew"), PlayerUnitsOfAtLeast(unit: "siphon", count: 2)],
     actions: [CompleteObjective("crew"),
               AddObjective(name: "forge", text: "Build a Forge to give the green teeth ([F])", optional: false),
               Say(speaker: "voice", text: "Now a Forge. It will shape bramble into something that bites.")]),
    // GrantAnima closes ROADMAP gap #3 (A124): the map's only anima source is the
    // ancient_tree, which First Light does not place, so draining its 3600 Stone
    // could never buy the one Stone recipe (Monolith needs 3 anima). A token grant
    // here - the moment the Forge exists - makes the Stone drain finally pay out.
    // Amount is [TUNE]; the prose is a placeholder for Ivan to rewrite.
    //
    // The anima note is a Message, NOT a second Say: two Says in one trigger fire
    // in the same tick and `update_mission_ui` OVERWRITES the whole SpeakerHud, so
    // the second would silently clobber the authored line on the portrait panel.
    // (Both would still reach the message feed.) Guarded by a test.
    (name: "forged",
     when: [ObjectiveActive("forge"), PlayerBuildingsOfAtLeast(building: "forge", count: 1)],
     actions: [CompleteObjective("forge"),
               GrantAnima(6.0),
               AddObjective(name: "army", text: "Make 3 Stalkers - your reinforcements (Forge)", optional: false),
               Message("Something settles under your ribs, cold and bright. Anima - a little of what the voice is. The stone will answer to it."),
               Say(speaker: "voice", text: "Make more of yourself. Three, to start. Thorn and bramble.")]),
    (name: "army up",
     when: [ObjectiveActive("army"), PlayerUnitsOfAtLeast(unit: "stalker", count: 3)],
     actions: [CompleteObjective("army"),
               GrantHeroXp(150.0),
               AddObjective(name: "destroy", text: "Destroy the fiery monsters", optional: false),
               Say(speaker: "voice", text: "Enough. Now - tear them apart.")]),
    (name: "cleared",
     when: [ObjectiveActive("destroy"), EnemyUnitsAtMost(0)],
     actions: [CompleteObjective("destroy"),
               GrantHeroXp(200.0),
               Message("Silence. Smoke. The green is still under your skin - and the voice has gone quiet, for now.")]),
    (name: "victory",
     when: [AllRequiredObjectivesComplete],
     actions: [Victory]),
    (name: "defeat",
     when: [PlayerWiped],
     actions: [Defeat]),
],
// The opening cinematic, two acts staged in-engine on the mountain itself.
// actors = [father, you, little brother] — three distinct figures the
// client spawns; they climb the central trail (kept inside the ramp
// corridor so they walk up the slopes, not over cliffs). The camera tightens
// on the family for the cave/door beats so they read. storm = gloom +
// lightning, flash = the door's whiteout. Sim units are hidden while it plays.
)
