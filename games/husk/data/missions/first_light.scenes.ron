(
intro: [
    // --- Act 1: the ascent, the storm, the cave ---
    (at: 0.0, camera: Some((0.0, 6.0, 0.68)), storm: 0.22,
     actors: [(2.5, 6.0), (-2.5, 3.0), (0.5, 0.0)],
     subtitle: "Three of you on the mountain - you, your father, your little brother."),
    (at: 5.0, camera: Some((0.0, 20.0, 0.52)), storm: 0.5,
     actors: [(3.0, 20.0), (-2.0, 17.0), (1.0, 14.0)],
     subtitle: "The climb was easy. Then the sky turned, and the storm came down like a fist."),
    (at: 10.5, camera: Some((0.0, 39.0, 0.34)), storm: 0.85,
     actors: [(3.0, 35.0), (-2.0, 34.0), (1.0, 32.0)],
     subtitle: "You ran for the high rocks - a cave, its mouth open in the stone."),
    (at: 16.0, camera: Some((0.0, 42.5, 0.2)), storm: 0.78,
     actors: [(2.8, 40.5), (-2.5, 40.5), (0.0, 42.5)],
     subtitle: "Deep in the dark stood a door of old stone, carved by no hand you knew."),
    // --- Act 2: the door, the burst, the white ---
    (at: 21.0, camera: Some((0.0, 42.0, 0.12)), storm: 0.6,
     actors: [(2.6, 42.0), (-2.0, 42.0), (0.0, 41.8)],
     subtitle: "Your little brother reached for it. 'Don't,' you said. He always did."),
    (at: 25.0, camera: Some((0.0, 42.0, 0.13)), storm: 0.4, flash: 0.5,
     actors: [(2.6, 42.0), (-2.0, 42.0), (0.0, 41.8)],
     subtitle: "His palm found the stone. The ring woke - and burned."),
    (at: 27.5, camera: Some((0.0, 42.0, 0.16)), flash: 1.0,
     actors: [(2.6, 42.0), (-2.0, 42.0), (0.0, 41.8)],
     subtitle: "The world turned white."),
],
outro: [
    (at: 0.0, camera: Some((0.0, -44.0, 0.32)), subtitle: "The fiery things are ash. You are still breathing, and it surprises you that you are."),
    (at: 6.0, camera: Some((0.0, 48.0, 0.5)), subtitle: "Your family is somewhere. The door is somewhere. The voice will be back. Down, then - into whatever is left of the world."),
],
)
