// The mountain: a big two-tier massif — a wide peak (tier 2) above a
// broad bench (tier 1), dropping to the valley. A central spine of
// ramps is the guaranteed descent (and the cutscene-actor corridor);
// FLANK ramps (east/west, both tiers) give alternate routes so you
// traverse and climb laterally, not just walk straight down. Polygon
// spurs break the boxy outline; bumps sculpt the summit + flanks.
plateaus: [
    (-22.0, 34.0, 22.0, 56.0, 2),   // the peak (wide), where he wakes
    (-44.0, 8.0, 44.0, 40.0, 1),    // the bench — a broad terrace
],
plateau_polys: [
    // craggy crown around the peak (tier 2) — irregular, not square
    ([(-22.0, 38.0), (-29.0, 46.0), (-20.0, 55.0), (-4.0, 56.0), (15.0, 55.0), (27.0, 47.0), (20.0, 38.0)], 2),
    // broad irregular flanks of the bench (tier 1), reaching outward
    ([(-44.0, 12.0), (-54.0, 20.0), (-52.0, 34.0), (-44.0, 38.0)], 1),
    ([(44.0, 14.0), (54.0, 22.0), (52.0, 35.0), (44.0, 38.0)], 1),
    // shoulders tying the bench up toward the peak (off the spine)
    ([(-32.0, 38.0), (-26.0, 45.0), (-16.0, 39.0)], 1),
    ([(18.0, 39.0), (27.0, 45.0), (33.0, 38.0)], 1),
],
ramps: [
    // central spine (the guaranteed descent + cutscene corridor)
    (-5.0, 31.0, 5.0, 39.0),        // peak -> bench
    (-5.0, 4.0, 5.0, 12.0),         // bench -> valley
    // flank routes (alternate ways to climb/descend)
    (-42.0, 5.0, -34.0, 14.0),      // west bench -> valley
    (34.0, 5.0, 42.0, 14.0),        // east bench -> valley
    (-22.0, 30.0, -14.0, 38.0),     // west peak -> bench
    (14.0, 30.0, 22.0, 38.0),       // east peak -> bench
],
