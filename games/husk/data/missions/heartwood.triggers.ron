(
objectives: [
    (name: "gather", text: "Gather 400 essence - drain trees, deadfall and boulders (right-click with the Extractor)", optional: false),
    (name: "heart", text: "Drain the Heartwood's anima on the summit (bank 20 anima)", optional: true),
    (name: "caches", text: "Recover both supply caches (gold glints)", optional: true),
],
triggers: [
    (name: "intro tip",
     when: [TimeAtLeast(2.0)],
     actions: [Message("You are alone, and that is enough. Right-click a tree: take it.")]),
    (name: "build tip",
     when: [EssenceAtLeast(250.0)],
     actions: [Message("Feel it pooling? At 400, raise the SANCTUM yourself - select the Extractor, press B, choose flat ground, then channel the site.")]),
    (name: "gathered",
     when: [ObjectiveActive("gather"), EssenceAtLeast(400.0)],
     actions: [CompleteObjective("gather"),
               GrantHeroXp(100.0),
               AddObjective(name: "found", text: "Raise the Sanctum ([B] with the Extractor selected, then channel the site)", optional: false),
               Message("Enough. Now give it shape.")]),
    (name: "founded",
     when: [ObjectiveActive("found"), PlayerBuildingsOfAtLeast(building: "sanctum", count: 1)],
     actions: [CompleteObjective("found"),
               GrantHeroXp(150.0),
               AddObjective(name: "crew", text: "Forge 2 Siphons to carry the work (Sanctum, Q)", optional: false),
               Message("The Sanctum beats in time with you. Forge Siphons to carry the gathering - you remain the heart.")]),
    (name: "crewed",
     when: [ObjectiveActive("crew"), PlayerUnitsOfAtLeast(unit: "siphon", count: 2)],
     actions: [CompleteObjective("crew"),
               AddObjective(name: "armory", text: "Build a Forge (Extractor or Siphon: [F])", optional: false),
               Message("They gather; you are free to fight and build. The truck wrecks hold steel - a Forge can shape it.")]),
    (name: "armed",
     when: [ObjectiveActive("armory"), PlayerBuildingsOfAtLeast(building: "forge", count: 1)],
     actions: [CompleteObjective("armory"),
               AddObjective(name: "army", text: "Field 8 Will of constructs", optional: false),
               Message("Steel for Golems, timber for Stalkers, stone for the slow giants. Build your pack.")]),
    (name: "army up",
     when: [ObjectiveActive("army"), ArmyWillAtLeast(8)],
     actions: [CompleteObjective("army"),
               GrantHeroXp(150.0),
               AddObjective(name: "summit", text: "Climb the mountain and break the grove guardians (southern switchback)", optional: false),
               Message("Wild constructs hold the summit grove - essence that grew teeth, with no hand guiding it. Show them a heart.")]),
    (name: "summit cleared",
     when: [ObjectiveActive("summit"), EnemyUnitsAtMost(0)],
     actions: [CompleteObjective("summit"),
               GrantHeroXp(200.0),
               Message("The grove is quiet. The Heartwood hums above the canopy - take its anima, or leave it beating.")]),
    (name: "heart drained",
     when: [AnimaAtLeast(20.0)],
     actions: [CompleteObjective("heart"),
               GrantEssence(150.0),
               GrantHeroXp(150.0),
               Message("The old tree's anima sings in your hands. Rare, and worth everything later.")]),
    (name: "caches found",
     when: [ItemsOnGroundAtMost(0)],
     actions: [CompleteObjective("caches"),
               GrantHeroXp(75.0),
               Message("Whoever stashed these knew about essence long before you woke.")]),
    (name: "victory",
     when: [AllRequiredObjectivesComplete],
     actions: [Victory]),
    (name: "defeat",
     when: [PlayerWiped],
     actions: [Defeat]),
],
)
