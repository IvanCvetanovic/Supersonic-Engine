// Hero progression & kit (brief §6). The unit shell lives in
// assets/units/extractor.ron; ability files in assets/abilities/.
// All numbers [TUNE].
(
    unit: "extractor",
    hp_per_level: 45.0,
    damage_per_level: 3.0,
    regen_base: 0.75,
    regen_per_level: 0.1,
    // cumulative XP to reach level 2..=10
    xp_curve: [200.0, 500.0, 900.0, 1400.0, 2000.0, 2700.0, 3500.0, 4400.0, 5400.0],
    // kills by any friendly within this range feed the hero (WC3 model)
    xp_radius: 16.0,
    // ability slots Q/W/E/R, by ability name (assets/abilities/*.ron)
    abilities: ["siphon surge", "overcharge", "pulse of the drained", "avatar of essence"],
    revive_cost_base: 100.0,
    revive_cost_per_level: 25.0,
    revive_time: 60.0,
)
