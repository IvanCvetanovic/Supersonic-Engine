// Deterministic enemy loot (brief §6). When an ENEMY unit of a listed kind
// dies in combat, each entry below is rolled INDEPENDENTLY against the sim RNG;
// on a hit the item drops on the ground at the death spot for the hero to walk
// over and collect. Keys are unit-kind names and each `item` is an item-kind
// name — both are matched against the unit/item catalogs case-insensitively.
// Tougher, rarer enemies leave the better charms. The hero, player thralls and
// enemy structures never drop (enforced in the sim, not here). All [TUNE].
{
    "soldier": [
        (item: "rebar knuckles", chance: 0.08),
    ],
    "swat trooper": [
        (item: "rebar knuckles", chance: 0.10),
        (item: "asphalt plating", chance: 0.04),
    ],
    "officer": [
        (item: "asphalt plating", chance: 0.12),
        (item: "field poultice", chance: 0.10),
    ],
    "cruiser": [
        (item: "asphalt plating", chance: 0.10),
        (item: "live wire charm", chance: 0.08),
        (item: "adrenal stim", chance: 0.08),
    ],
    "tank": [
        (item: "asphalt plating", chance: 0.16),
        (item: "field poultice", chance: 0.14),
    ],
    "artillery": [
        (item: "live wire charm", chance: 0.14),
        (item: "adrenal stim", chance: 0.10),
    ],
}
