build/
# Any out-of-source build tree, not just the default one. The Android
# configure writes build-android-<abi>/ and its CMakeCache and compiler
# probes went into a commit before this line existed.
build-*/
.cache/
*.exe
*.o
*.obj
*.a
*.lib
third_party/tools/

imgui.ini

# What ctest writes into the directory it is run from. Run from the project
# root instead of with --test-dir, it lands here, and one run's log and cost
# table went into a commit before this line existed.
Testing/

# Packaged games. Build output, not source - and a full copy of the engine
# binary plus every asset, which has no business in the repository.
/dist/

# The pipeline cache is a per-machine, per-driver build artifact that the
# engine rewrites on every run. Committing it churns a binary in every diff
# and is worse than useless on anyone else's GPU, which will not accept it.
cache/

# Scratch files the suites write into the directory they run from - the project
# root, for the nine that need the engine's assets - and normally delete again.
# A suite that crashes leaves them behind; this keeps that out of `git status`.
/test_*_tmp*
