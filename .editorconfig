# Editor defaults, so a contributor's IDE does not reformat a file on save and
# bury the actual change in a whitespace diff.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.{yml,yaml,json,gltf}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown, so trimming them
# silently changes the rendered output.
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

# Vendored code keeps whatever its upstream uses.
[third_party/**]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
insert_final_newline = unset
max_line_length = unset
